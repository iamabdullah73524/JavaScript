const max = prompt("enter the max number");

const random = Math.floor(Math.random() * max) + 1;

let guess = prompt("guess the generated numbder");

while (true) {
  if (guess == "quit") {
    console.log("you quit");
    break;
  } else if (guess == random) {
    console.log("Cong! , You win");
    break;
  } else if (guess < random) {
    guess = prompt("your guess is too small,plz tru again");
  } else if (guess > random) {
    guess = prompt("your guess is too large, plx try again");
  }
}
