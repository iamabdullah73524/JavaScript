let country = ["Australia","Germany","UnitesStateOfAmerica","India"];

function longestName(country){
  let ansidx=0;

  for(let i=1 ; i<country.length ; i++){
    let ans = country[ansidx];
    let curr = country[i];
    if(curr.length>ans.length){
      ansidx=i;
    }
  }
  return ansidx;
}

let a = longestName(country);
console.log(country[a]);
